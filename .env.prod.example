# Modèle du fichier .env de PRODUCTION (à créer sur la machine cible, jamais committé).
# Utilisé par docker-compose.prod.yml.

# Version de l'image API à déployer (tag SemVer ou latest)
API_VERSION=latest

# PostgreSQL
POSTGRES_USER=soundproof
POSTGRES_PASSWORD=changez_moi_mot_de_passe_fort
POSTGRES_DB=soundproof

# Secrets JWT — générer des valeurs aléatoires longues (ex. : openssl rand -hex 64)
JWT_ACCESS_SECRET=changez_moi_secret_access
JWT_REFRESH_SECRET=changez_moi_secret_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
