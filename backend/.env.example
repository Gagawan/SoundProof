# Connexion PostgreSQL (voir docker-compose.yml pour la BDD de développement)
DATABASE_URL=postgresql://soundproof:soundproof_password@localhost:5432/soundproof?schema=public

# Secrets JWT — générer des valeurs aléatoires longues (ex. : openssl rand -hex 64)
JWT_ACCESS_SECRET=changez_moi_secret_access_factice
JWT_REFRESH_SECRET=changez_moi_secret_refresh_factice

# Durées de vie des tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Port d'écoute de l'API
PORT=3000
