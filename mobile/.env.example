# URL de l'API joignable depuis le téléphone ou l'émulateur.
# ⚠️ Ne PAS utiliser localhost : l'app tourne sur un appareil distinct de la machine de dev.
# - Téléphone physique (même Wi-Fi) : http://<IP-locale-de-votre-machine>:3000 (ex. http://192.168.1.42:3000)
# - Émulateur Android : http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
